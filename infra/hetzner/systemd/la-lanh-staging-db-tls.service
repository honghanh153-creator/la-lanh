[Unit]
Description=Renew the staging database TLS pair before it expires (incident 2026-11-10)
OnFailure=la-lanh-alert@%n.service
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/la-lanh/staging/source/infra/hetzner/staging/renew-db-tls.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/la-lanh/staging/secrets
UMask=0077
TimeoutStartSec=10min
