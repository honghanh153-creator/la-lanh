[Unit]
Description=Lá Lành expired guest cleanup
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/la-lanh/current
ExecStart=/usr/local/sbin/la-lanh-retention-job guests
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
TimeoutStartSec=20min
UMask=0077
