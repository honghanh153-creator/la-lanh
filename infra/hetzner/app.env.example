# Non-secret settings only. Copy to app.env on the server.
LA_LANH_ENVIRONMENT=staging
LA_LANH_SERVICE_NAME=la-lanh-api
LA_LANH_CORS_ORIGINS=["https://la-lanh.2-28-136-44.sslip.io"]
LA_LANH_LOG_LEVEL=INFO
LA_LANH_GUEST_COOKIE_SECURE=true
LA_LANH_NATIVE_APP_ENABLED=false
LA_LANH_AUTH_ENABLED=false
LA_LANH_AUTH_GOOGLE_ENABLED=false
LA_LANH_AUTH_DELIVERY_APPROVED=false
# Populate only after provider erasure and live Google acceptance are verified.
# LA_LANH_AUTH_GOOGLE_CALLBACK_URL=https://your-app.example/auth/callback
# LA_LANH_AUTH_SUPABASE_URL=https://your-project.supabase.co
# LA_LANH_AUTH_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
LA_LANH_GENERATION_ENABLED=false
LA_LANH_GENERATION_PROVIDER=disabled
LA_LANH_GENERATION_GOVERNANCE_APPROVED=false
LA_LANH_GENERATION_SPEND_APPROVED=false
LA_LANH_GENERATION_DAILY_TOKEN_BUDGET=0
LA_LANH_GENERATION_DAILY_BUDGET_CENTS=0
LA_LANH_GENERATION_SURFACE_ROLLOUT={}
LA_LANH_REQUIRE_WEB_DIST=true
# B3-1a per-person Daily rotation. Unset = off. When enabling, use a date AFTER the
# deploy day (Asia/Ho_Chi_Minh) so notes already opened today never change.
# LA_LANH_DAILY_VARIETY_FROM=2026-10-25

# Must be changed to "agpl" or "professional" only after the corresponding
# license posture is approved and evidenced. Staging refuses "development".
LA_LANH_SWISSEPH_LICENSE_MODE=development
