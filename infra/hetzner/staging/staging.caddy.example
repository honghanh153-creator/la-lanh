# Copy to infra/hetzner/sites/staging.caddy on the server (with the real
# hostname) to publish the staging stack through the shared Caddy.
staging.la-lanh.2-28-136-44.sslip.io {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}
	reverse_proxy staging-app:8080 {
		health_uri /v1/ready
		health_interval 30s
		health_timeout 5s
	}
}
