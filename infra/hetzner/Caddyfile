{
	admin off
}

{$APP_HOSTNAME} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	# Route counters stay internal (PV-24, #180): only callers inside the
	# compose network reach the app's /metrics; the public site answers 404.
	respond /metrics* 404

	reverse_proxy app:8080 {
		health_uri /v1/ready
		health_interval 30s
		health_timeout 5s
	}
}

import /etc/caddy/sites/*.caddy
