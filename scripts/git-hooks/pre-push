#!/bin/bash
# Optional: `git config core.hooksPath scripts/git-hooks` runs the offline preflight before every push,
# so a leaked key or personal data in a log never reaches the public repo (collab-auto-loop-plan.md 4.4).
set -uo pipefail
node_bin="$(command -v node || true)"
[ -n "$node_bin" ] || node_bin="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node"
root="$(/usr/bin/git rev-parse --show-toplevel)"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletions push the zero SHA and add nothing.
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  "$node_bin" "$root/scripts/collab-preflight.mjs" --head "$local_sha" || status=1
done
if [ "$status" -ne 0 ]; then
  echo "pre-push: soát nhanh có lỗi, chưa push. Sửa rồi push lại." >&2
fi
exit "$status"
