POSTGRES_DB=la_lanh
POSTGRES_USER=la_lanh
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

LA_LANH_ENVIRONMENT=development
# Zero-setup local persistence. Production must use postgresql+asyncpg.
LA_LANH_DATABASE_URL=sqlite+aiosqlite:///./la_lanh_dev.db
LA_LANH_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
LA_LANH_LOG_LEVEL=INFO
LA_LANH_CONSENT_VERSION=birth-profile-v1
LA_LANH_CONSENT_PURPOSE=birth_profile_basic
LA_LANH_GUEST_COOKIE_NAME=la_lanh_guest
LA_LANH_GUEST_CSRF_COOKIE_NAME=la_lanh_csrf
LA_LANH_GUEST_COOKIE_SECURE=false
# Local-only keys. Generate separate 32-byte URL-safe base64 secrets for staging/production.
LA_LANH_GUEST_HASH_KEY=bGEtbGFuaC1kZXYtaGFzaC1rZXktMzItYnl0ZXMhISE=
LA_LANH_GUEST_ENCRYPTION_KEY=bGEtbGFuaC1kZXYtZW5jcnlwdGlvbi1rZXktMzIhISE=

VITE_API_BASE_URL=/v1
